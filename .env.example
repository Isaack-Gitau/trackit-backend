# ============================================================================
# TRACKIT Environment Configuration
# ============================================================================

# ============================================================================
# Application
# ============================================================================

APP_NAME=TRACKIT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ============================================================================
# PostgreSQL
# ============================================================================

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/trackit_db

# ============================================================================
# JWT Authentication
# ============================================================================

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Authentication Rate Limiting
# ============================================================================

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

VERIFICATION_RATE_LIMIT_ATTEMPTS=3
VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=900

REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900

# ============================================================================
# Media / Image Uploads
# ============================================================================

# Local storage location for user-uploaded media.
MEDIA_ROOT=storage/media

# Public URL prefix for served media.
MEDIA_URL=/media

# Maximum uploaded image size: 5 MiB.
IMAGE_MAX_SIZE_BYTES=5242880

# Maximum decoded image dimensions.
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096

# Maximum total decoded pixels: 16 megapixels.
IMAGE_MAX_PIXELS=16777216

# Accepted image formats.
# SVG is intentionally excluded.
IMAGE_ALLOWED_FORMATS=JPEG,PNG,WEBP

# ============================================================================
# CORS
# ============================================================================

# Multiple origins can be comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5500

CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Trusted Hosts
# ============================================================================

TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# ============================================================================
# Security Headers
# ============================================================================

SECURITY_HEADERS_ENABLED=true

# Enable only when serving TRACKIT over HTTPS.
HSTS_ENABLED=false

HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# ============================================================================
# Email / SMTP
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

SMTP_FROM_EMAIL=YOUR_FROM_EMAIL
SMTP_FROM_NAME=TRACKIT

SMTP_USE_TLS=true

# ============================================================================
# Frontend
# ============================================================================

FRONTEND_URL=http://localhost:5500

# ============================================================================
# Rate-Limit Storage
# ============================================================================

# Development:
#   memory
# Production:
#   redis

RATE_LIMIT_BACKEND=memory

REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_FAIL_CLOSED=true

# ============================================================================
# Argon2 Password Hashing
# ============================================================================

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4